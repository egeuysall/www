---
import Pagination from "@/components/ui/pagination.astro";
import { DitherShader } from "@/components/ui/dither-shader";
import PhotoGalleryPrefetch from "@/components/photos/PhotoGalleryPrefetch";
import type { PhotoAsset } from "@/lib/photos";

interface Props {
  photos: PhotoAsset[];
  currentPage: number;
  totalPages: number;
  configured: boolean;
  nextPageHref?: string;
  nextPageImageUrls?: string[];
}

const {
  photos,
  currentPage,
  totalPages,
  configured,
  nextPageHref,
  nextPageImageUrls = [],
} = Astro.props;
---

<div class="mx-auto w-full md:max-w-[48rem]">
  {
    photos.length > 0 ? (
      <ol class="m-0 grid list-none gap-6 p-0 sm:grid-cols-2 md:justify-items-center">
      {photos.map((photo, index) => (
        <li class="animate-enter w-full md:max-w-[22.5rem]" style={`--delay: ${140 + (index % 6) * 55}ms;`}>
          <a
            href={`/photo/${photo.slug}/`}
            class="group block"
            aria-label={`Open ${photo.title} story`}
          >
            <div class="not-prose relative aspect-[4/5] w-full overflow-hidden rounded-sm border border-neutral-800">
              <img
                src={photo.displaySrc}
                sizes="(min-width: 640px) 44vw, 100vw"
                alt={photo.alt}
                width={720}
                height={900}
                loading={currentPage === 1 && index === 0 ? "eager" : "lazy"}
                decoding="async"
                fetchpriority={currentPage === 1 && index === 0 ? "high" : "auto"}
                class="h-full w-full object-cover"
              />

              <DitherShader
                client:load
                src={photo.ditherSrc}
                processingWidth={256}
                maxResizeWidth={256}
                maxResizeHeight={256}
                threshold={0.6}
                brightness={-0.2}
                className="pointer-events-none transition-opacity duration-300 ease-out group-hover:opacity-0 group-focus-visible:opacity-0"
              />
            </div>
          </a>
        </li>
      ))}
      </ol>
    ) : (
      <section class="animate-enter" style="--delay: 120ms;">
        <div class="row-border py-6">
          <p class="text-sm text-neutral-100">No photos available yet.</p>
          <p class="mt-2 max-w-[56ch] text-xs leading-relaxed text-neutral-400">
            {configured
              ? "The photo archive is empty."
              : "Add photo notes in /src/content/photo/ with frontmatter fields like title, imageUrl, and publishedAt."}
          </p>
        </div>
      </section>
    )
  }

  <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/photo" ariaLabel="Photo pagination" />
  <PhotoGalleryPrefetch
    client:load
    nextPageHref={nextPageHref}
    nextPageImageUrls={nextPageImageUrls}
    maxNetworkWidth={1350}
  />
</div>
