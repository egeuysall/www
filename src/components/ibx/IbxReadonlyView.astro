---
import Pagination from "@/components/ui/pagination.astro";
import type { IbxTodo } from "@/lib/ibx-readonly";

interface Props {
  todos: IbxTodo[];
  error: string | null;
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { todos, error, currentPage, totalPages, basePath } = Astro.props;

function getPriorityLabel(value: number): string {
  if (!Number.isFinite(value)) {
    return "P2";
  }

  const rounded = Math.round(value);
  const clamped = Math.min(3, Math.max(1, rounded));
  return `P${clamped}`;
}
---

{
  error ? (
    <section class="animate-enter" style="--delay: 40ms;">
      <p class="rounded-sm border border-neutral-800 bg-neutral-950/40 px-3 py-2 text-xs text-neutral-300">
        IBX feed is temporarily unavailable ({error}).
      </p>
    </section>
  ) : (
    <section class="animate-enter" style="--delay: 40ms;">
      <ol class="space-y-4">
        {todos.length === 0 ? (
          <li class="row-border pb-4">
            <p class="text-xs text-neutral-400">No tasks due today.</p>
          </li>
        ) : (
          todos.map((todo) => (
            <li class="row-border pb-4">
              <p class="text-[11px] text-neutral-400">
                {todo.status === "done" ? "Done" : "Open"}{" "}
                <span aria-hidden="true">&middot;</span>{" "}
                {todo.isGtm ? (
                  <>
                    GTM <span aria-hidden="true">&middot;</span>{" "}
                  </>
                ) : null}
                {getPriorityLabel(todo.priority)}
              </p>
              <p class="mt-1 max-w-full truncate text-sm text-neutral-100" title={todo.title}>
                {todo.title}
              </p>
            </li>
          ))
        )}
      </ol>

      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        basePath={basePath}
        ariaLabel="Task pagination"
      />
    </section>
  )
}
