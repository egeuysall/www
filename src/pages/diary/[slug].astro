---
import { getCollection, type CollectionEntry } from "astro:content";

import MdxImage from "@/components/content/MdxImage.astro";
import { mdxComponents } from "@/components/content/mdx-components";
import { SITE } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDiaryDayMap, getDiaryEntrySlug } from "@/lib/content";
import { formatDate } from "@/lib/utils";

type Props = {
  entry: CollectionEntry<"diary">;
  dayNumber: number;
  slug: string;
};

export async function getStaticPaths() {
  const entries = await getCollection("diary", ({ data }) => !data.draft);
  const dayMap = await getDiaryDayMap();

  return entries.map((entry) => {
    const slug = getDiaryEntrySlug(entry);

    return {
      params: { slug },
      props: {
        entry,
        dayNumber: dayMap.get(entry.id) ?? 0,
        slug,
      },
    };
  });
}

const { entry, dayNumber, slug } = Astro.props as Props;
const { Content } = await entry.render();
const canonicalPath = `/diary/${slug}/`;
const siteOrigin = Astro.site ?? new URL(SITE.url);
const contentComponents = {
  ...mdxComponents,
  Image: MdxImage,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: `Day ${dayNumber}`,
  description: entry.data.summary,
  datePublished: entry.data.date.toISOString(),
  dateModified: entry.data.date.toISOString(),
  mainEntityOfPage: new URL(canonicalPath, siteOrigin).toString(),
  author: {
    "@type": "Person",
    name: SITE.author.name,
  },
};
---

<BaseLayout
  title={`Day ${dayNumber}`}
  description={entry.data.summary}
  pathname={canonicalPath}
  type="article"
  publishedTime={entry.data.date.toISOString()}
  updatedTime={entry.data.date.toISOString()}
  jsonLd={jsonLd}
>
  <article
    class="prose prose-neutral prose-invert max-w-none animate-enter prose-p:text-neutral-300 prose-headings:text-neutral-100 prose-strong:text-neutral-100 prose-a:text-neutral-100 prose-a:decoration-neutral-700 prose-hr:border-neutral-800 prose-pre:border prose-pre:border-neutral-800 prose-pre:text-neutral-200 prose-code:text-neutral-200"
    style="--delay: 40ms;"
  >
    <header class="mb-6 border-b border-neutral-900 pb-5">
      <h1 class="text-base text-neutral-100">Day {dayNumber}</h1>
      <p class="mt-2 text-xs text-neutral-600">{formatDate(entry.data.date)}</p>
      <p class="mt-2 text-sm text-neutral-400">{entry.data.summary}</p>
    </header>

    <Content components={contentComponents} />
  </article>
</BaseLayout>
