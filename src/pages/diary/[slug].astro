---
import { getCollection, render, type CollectionEntry } from "astro:content";

import MdxImage from "@/components/content/MdxImage.astro";
import { mdxComponents } from "@/components/content/mdx-components";
import { SITE } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolveContentCdnShorthand } from "@/lib/content-cdn";
import { getDiaryDayMap, getDiaryEntrySlug } from "@/lib/content";
import { formatDate } from "@/lib/utils";

type Props = {
  entry: CollectionEntry<"diary">;
  dayNumber: number;
  slug: string;
};

export async function getStaticPaths() {
  const entries = await getCollection("diary", ({ data }) => !data.draft);
  const dayMap = await getDiaryDayMap();

  return entries.map((entry) => {
    const slug = getDiaryEntrySlug(entry);

    return {
      params: { slug },
      props: {
        entry,
        dayNumber: dayMap.get(entry.id) ?? 0,
        slug,
      },
    };
  });
}

const { entry, dayNumber, slug } = Astro.props as Props;
const { Content } = await render(entry);
const canonicalPath = `/diary/${slug}/`;
const entryImageSource = entry.data.image
  ? resolveContentCdnShorthand(entry.data.image)
  : undefined;
const entryOgImage = entryImageSource ? `/og/diary/${slug}.png` : undefined;
const siteOrigin = Astro.site ?? new URL(SITE.url);
const contentComponents = {
  ...mdxComponents,
  Image: MdxImage,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.summary,
  description: entry.data.summary,
  datePublished: entry.data.date.toISOString(),
  dateModified: entry.data.date.toISOString(),
  mainEntityOfPage: new URL(canonicalPath, siteOrigin).toString(),
  ...(entryImageSource
    ? {
        image: [new URL(entryImageSource, siteOrigin).toString()],
      }
    : {}),
  author: {
    "@type": "Person",
    name: SITE.author.name,
  },
};
---

<BaseLayout
  title={entry.data.summary}
  description={entry.data.summary}
  pathname={canonicalPath}
  image={entryOgImage ?? entryImageSource}
  type="article"
  publishedTime={entry.data.date.toISOString()}
  updatedTime={entry.data.date.toISOString()}
  jsonLd={jsonLd}
>
  <article
    class="animate-enter prose prose-neutral prose-invert max-w-none prose-p:text-neutral-300 prose-headings:text-neutral-100 prose-h2:text-[0.95rem]! prose-h2:leading-6! prose-h2:font-medium! prose-h3:text-[0.88rem]! prose-h3:leading-6 prose-h3:font-medium! prose-h4:text-[0.82rem]! prose-h4:leading-5! prose-h4:font-medium! prose-strong:font-semibold! prose-strong:text-neutral-100 prose-a:text-neutral-100 prose-a:decoration-neutral-700 prose-hr:border-neutral-900 prose-thead:!border-neutral-900 prose-tr:!border-neutral-900 prose-th:!border-neutral-900 prose-td:!border-neutral-900 prose-pre:border prose-pre:border-neutral-800 prose-pre:text-neutral-200 prose-code:text-neutral-200"
    style="--delay: 40ms;"
  >
    <header class="mb-6 border-b border-neutral-900 pb-5">
      <h1 class="text-base font-semibold! text-neutral-100">{entry.data.summary}</h1>
      <p class="mt-2 text-xs text-neutral-400">
        {formatDate(entry.data.date)} &middot; Day {dayNumber}
      </p>
    </header>

    <Content components={contentComponents} />
  </article>
</BaseLayout>
