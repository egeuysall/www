---
import type { CollectionEntry } from "astro:content";

import Pagination from "@/components/ui/pagination.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDiaryDayMap, getDiaryEntrySlug, getPublishedDiaryEntries } from "@/lib/content";
import { getStaticPaginationPages, paginateItems } from "@/lib/pagination";

type Props = {
  page: number;
  entries: CollectionEntry<"diary">[];
  dayMap: Map<string, number>;
};

export async function getStaticPaths() {
  const entries = await getPublishedDiaryEntries();
  const dayMap = await getDiaryDayMap();
  const pages = getStaticPaginationPages(entries.length, 9).filter((page) => page > 1);

  return pages.map((page) => ({
    params: { page: String(page) },
    props: {
      page,
      entries,
      dayMap,
    },
  }));
}

const { page, entries, dayMap } = Astro.props as Props;
const pagination = paginateItems(entries, page, 9);
---

<BaseLayout
  title={`Diary - Page ${pagination.currentPage}`}
  pathname={`/diary/page/${pagination.currentPage}/`}
  description="Daily short progress notes, sorted by date."
  noindex
>
  <section class="animate-enter" style="--delay: 110ms;">
    <ol class="space-y-4">
      {pagination.items.map((entry) => {
        const dayNumber = dayMap.get(entry.id) ?? 0;

        return (
          <li class="row-border pb-4">
            <a href={`/diary/${getDiaryEntrySlug(entry)}/`} class="block">
              <p class="text-xs text-neutral-400 tabular-nums">
                Day {dayNumber}
              </p>
              <p class="mt-2 text-sm text-neutral-100">{entry.data.summary}</p>
            </a>
          </li>
        );
      })}
    </ol>
  </section>
  <Pagination currentPage={pagination.currentPage} totalPages={pagination.totalPages} basePath="/diary" />
</BaseLayout>
