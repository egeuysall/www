---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404" pathname="/404" description="Page not found." noindex>
  <section class="animate-enter flex min-h-[55vh] flex-col items-center justify-center text-center" style="--delay: 40ms;">
    <p class="text-2xl tracking-tight text-neutral-100">404</p>
    <p class="mt-3 text-sm text-neutral-500">This page does not exist.</p>
    <a href="/" class="mt-6 inline-block text-sm text-neutral-400 hover:text-neutral-200">Go home</a>
  </section>
</BaseLayout>
