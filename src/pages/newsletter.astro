---
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = false;

const status = Astro.url.searchParams.get("status");
const unsubscribeToken = Astro.url.searchParams.get("unsubscribe");
const message = unsubscribeToken
  ? "Are you sure you want to unsubscribe from new posts?"
  : status === "check"
    ? "Check your email and confirm the subscription."
    : status === "confirmed"
      ? "You’re subscribed."
      : status === "unsubscribed"
        ? "You’re unsubscribed."
        : status === "error"
          ? "That link is invalid or expired."
          : "Get new posts by email. No account or password required.";
---

<BaseLayout title="Newsletter" pathname="/newsletter">
  <section class="animate-enter" style="--delay: 40ms;">
    <p class="max-w-lg text-sm leading-relaxed text-neutral-300">{message}</p>
    {unsubscribeToken ? (
      <form id="newsletter-unsubscribe-form" data-newsletter-form action="/api/newsletter" method="post" enctype="application/x-www-form-urlencoded" class="mt-6 max-w-lg">
        <input type="hidden" name="unsubscribe" value={unsubscribeToken} />
        <div class="flex gap-2">
          <button type="submit" class="rounded-sm border border-neutral-700 px-3 py-2 text-xs text-neutral-100 hover:border-neutral-400">
            Unsubscribe
          </button>
          <a href="/newsletter/" class="rounded-sm border border-neutral-800 px-3 py-2 text-xs text-neutral-400 hover:border-neutral-500 hover:text-neutral-100">
            Keep me subscribed
          </a>
        </div>
        <p data-newsletter-status class="mt-3 text-xs text-neutral-400" aria-live="polite" hidden></p>
      </form>
    ) : status !== "confirmed" && status !== "unsubscribed" ? (
      <form id="newsletter-subscribe-form" data-newsletter-form action="/api/newsletter" method="post" enctype="application/x-www-form-urlencoded" class="mt-6 max-w-lg">
        <div class="flex gap-2">
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="min-w-0 flex-1 rounded-sm border border-neutral-800 bg-transparent px-3 py-2 text-sm text-neutral-100 outline-none placeholder:text-neutral-600 focus:border-neutral-500"
        />
        <button type="submit" class="rounded-sm border border-neutral-700 px-3 py-2 text-xs text-neutral-100 hover:border-neutral-400">
          Subscribe
        </button>
        </div>
        <p data-newsletter-status class="mt-3 text-xs text-neutral-400" aria-live="polite" hidden></p>
      </form>
    ) : null}
  </section>
</BaseLayout>

<script>
  function bindNewsletterForms() {
    document.querySelectorAll("[data-newsletter-form]").forEach((form) => {
      if (form.dataset.newsletterBound) return;
      form.dataset.newsletterBound = "true";
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const button = form.querySelector("button[type='submit']");
        const status = form.querySelector("[data-newsletter-status]");
        if (!(button instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return;

        button.disabled = true;
        status.hidden = false;
        status.textContent = "Sending...";
        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { Accept: "application/json", "Content-Type": "application/json" },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(typeof result.error === "string" ? result.error : "Something went wrong. Please try again.");
          status.textContent = typeof result.message === "string" ? result.message : "Done.";
          if (form.id === "newsletter-unsubscribe-form") {
            form.querySelector("div")?.remove();
          }
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : "Something went wrong. Please try again.";
          button.disabled = false;
        }
      });
    });
  }

  bindNewsletterForms();
  document.addEventListener("astro:page-load", bindNewsletterForms);
</script>
