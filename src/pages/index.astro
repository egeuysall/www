---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDiaryDayMap, getDiaryEntrySlug, getPublishedBlogPosts, getPublishedDiaryEntries } from "@/lib/content";
import { formatDate } from "@/lib/utils";
import { PROJECTS, SITE, SOCIAL_LINKS } from "@/config/site";

const blogPosts = await getPublishedBlogPosts();
const diaryEntries = await getPublishedDiaryEntries();
const diaryDayMap = await getDiaryDayMap();

const recentPosts = blogPosts.slice(0, 5);
const recentDiary = diaryEntries.slice(0, 5);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: SITE.author.name,
    jobTitle: SITE.author.role,
    url: SITE.url,
    sameAs: SOCIAL_LINKS.map((link) => link.href),
  },
];
---

<BaseLayout title="Home" pathname="/" jsonLd={jsonLd}>
  <section>
    <p class="animate-enter text-sm leading-6 text-neutral-200" style="--delay: 40ms;">
      I'm a founder building SaaS products at 16.
    </p>
    <p class="animate-enter mt-1 text-xs leading-5 text-neutral-400" style="--delay: 105ms;">
      Based in Chicago, building Ryva.
    </p>
  </section>

  <section class="mt-12">
    <h2 class="animate-enter text-sm font-semibold tracking-normal text-neutral-100" style="--delay: 170ms;">Projects</h2>
    <ul class="mt-4">
      {PROJECTS.map((project, index) => (
        <li class="row-border animate-enter py-3" style={`--delay: ${225 + index * 65}ms;`}>
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="block hover:text-neutral-100">
            <div class="flex items-start justify-between gap-6">
              <div>
                <p class="text-[13px] font-medium leading-5 text-neutral-100">{project.title}</p>
                <p class="mt-0.5 text-xs leading-5 text-neutral-400">{project.summary}</p>
              </div>
              <p class="shrink-0 pt-0.5 text-[11px] text-neutral-400">{project.linkLabel ?? "Open"}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-10">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="animate-enter text-sm font-semibold tracking-normal text-neutral-100" style="--delay: 440ms;">Latest Blog</h2>
      <a href="/blog" class="animate-enter text-[11px] text-neutral-400 hover:text-neutral-200" style="--delay: 440ms;" aria-label="See all blog posts"
        >See all</a
      >
    </div>
    <ul>
      {recentPosts.map((post, index) => (
        <li class="row-border animate-enter py-3" style={`--delay: ${495 + index * 65}ms;`}>
          <a href={`/blog/${post.id}/`} class="block hover:text-neutral-100">
            <div class="flex items-start justify-between gap-6">
              <p class="text-[13px] font-medium leading-5 text-neutral-100">{post.data.title}</p>
              <p class="shrink-0 pt-0.5 text-xs leading-5 text-neutral-400 tabular-nums">{formatDate(post.data.publishedAt)}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-10">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="animate-enter text-sm font-semibold tracking-normal text-neutral-100" style="--delay: 850ms;">Recent Diary</h2>
      <a
        href="/diary"
        class="animate-enter text-[11px] text-neutral-400 hover:text-neutral-200"
        style="--delay: 850ms;"
        aria-label="See all diary entries">See all</a
      >
    </div>
    <ol>
      {recentDiary.map((entry, index) => {
        const day = diaryDayMap.get(entry.id) ?? 0;
        return (
          <li class="row-border animate-enter py-3" style={`--delay: ${905 + index * 65}ms;`}>
            <a href={`/diary/${getDiaryEntrySlug(entry)}/`} class="block hover:text-neutral-100">
              <div class="flex items-start justify-between gap-6">
                <p class="text-[13px] font-medium leading-5 text-neutral-100">{entry.data.summary}</p>
                <p class="shrink-0 pt-0.5 text-xs leading-5 text-neutral-400 tabular-nums">
                  Day {day}
                </p>
              </div>
            </a>
          </li>
        );
      })}
    </ol>
  </section>
</BaseLayout>
