---
import ScrollPhotoGallery from "@/components/photos/ScrollPhotoGallery.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPhotoFeed } from "@/lib/photos";

const photos = await getPhotoFeed();
---

<BaseLayout
  title="Photo"
  pathname="/photo/"
  description="Portrait photo archive by Ege Uysal."
  mainClass="relative left-1/2 w-screen max-w-none -translate-x-1/2"
>
  <ScrollPhotoGallery photos={photos} />
</BaseLayout>
