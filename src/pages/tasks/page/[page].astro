---
import IbxReadonlyView from "@/components/ibx/IbxReadonlyView.astro";
import { SITE } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  IBX_TODOS_PAGE_SIZE,
  getTodayIbxTodos,
  type IbxTodo,
  loadIbxReadonlyPageState,
} from "@/lib/ibx-readonly";
import { getStaticPaginationPages, paginateItems } from "@/lib/pagination";

type Props = {
  page: number;
  todos: IbxTodo[];
};

export async function getStaticPaths() {
  const { snapshot, error } = await loadIbxReadonlyPageState(SITE.timezone);

  if (error || !snapshot) {
    return [];
  }

  const todos = getTodayIbxTodos(snapshot);
  const pages = getStaticPaginationPages(todos.length, IBX_TODOS_PAGE_SIZE).filter(
    (page) => page > 1,
  );

  return pages.map((page) => ({
    params: { page: String(page) },
    props: {
      page,
      todos,
    },
  }));
}

const { page, todos } = Astro.props as Props;
const pagination = paginateItems(todos, page, IBX_TODOS_PAGE_SIZE);
---

<BaseLayout
  title={`Tasks - Page ${pagination.currentPage}`}
  pathname={`/tasks/page/${pagination.currentPage}/`}
  description="Public, read-only task feed."
  noindex
>
  <IbxReadonlyView
    todos={pagination.items}
    error={null}
    currentPage={pagination.currentPage}
    totalPages={pagination.totalPages}
    basePath="/tasks"
  />
</BaseLayout>
