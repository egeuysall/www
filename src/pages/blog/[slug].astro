---
import { getCollection, render, type CollectionEntry } from "astro:content";

import MdxImage from "@/components/content/MdxImage.astro";
import { mdxComponents } from "@/components/content/mdx-components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/lib/utils";
import { SITE } from "@/config/site";

type Props = {
  post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as Props;
const { Content } = await render(post);

const canonicalPath = `/blog/${post.id}/`;
const postImage = post.data.image;
const siteOrigin = Astro.site ?? new URL(SITE.url);
const contentComponents = {
  ...mdxComponents,
  Image: MdxImage,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  mainEntityOfPage: new URL(canonicalPath, siteOrigin).toString(),
  ...(postImage
    ? {
        image: [new URL(postImage, siteOrigin).toString()],
      }
    : {}),
  author: {
    "@type": "Person",
    name: SITE.author.name,
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  pathname={canonicalPath}
  image={postImage}
  type="article"
  publishedTime={post.data.publishedAt.toISOString()}
  updatedTime={(post.data.updatedAt ?? post.data.publishedAt).toISOString()}
  jsonLd={jsonLd}
>
  <article
    class="prose prose-neutral font-bold prose-invert max-w-none animate-enter prose-p:text-neutral-300 prose-headings:text-neutral-100 prose-h2:text-[0.95rem]! prose-h2:leading-6! prose-h2:font-medium! prose-h3:text-[0.88rem]! prose-h3:leading-6! prose-h3:font-medium! prose-h4:text-[0.82rem]! prose-h4:leading-5! prose-h4:font-medium prose-strong:font-semibold! prose-strong:text-neutral-100 prose-a:text-neutral-100 prose-a:decoration-neutral-700 prose-hr:border-neutral-900 prose-thead:!border-neutral-900 prose-tr:!border-neutral-900 prose-th:!border-neutral-900 prose-td:!border-neutral-900 prose-pre:border prose-pre:border-neutral-800 prose-pre:text-neutral-200 prose-code:text-neutral-200"
    style="--delay: 40ms;"
  >
    <header class="mb-6 border-b border-neutral-900 pb-5">
      <h1 class="text-base font-semibold! text-neutral-100">{post.data.title}</h1>
      <p class="mt-2 text-xs text-neutral-400">
        {formatDate(post.data.publishedAt)}
        {post.data.updatedAt ? (
          <>
            {" "}
            &middot; updated {formatDate(post.data.updatedAt)}
          </>
        ) : null}
      </p>
    </header>

    <Content components={contentComponents} />
  </article>
</BaseLayout>
