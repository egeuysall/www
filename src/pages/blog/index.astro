---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Pagination from "@/components/ui/pagination.astro";
import { getPublishedBlogPosts } from "@/lib/content";
import { paginateItems } from "@/lib/pagination";
import { formatDate } from "@/lib/utils";
import ViewCount from "@/components/engagement/ViewCount";

const posts = await getPublishedBlogPosts();
const pagination = paginateItems(posts, 1, 9);
const convexUrl = import.meta.env.PUBLIC_CONVEX_URL;
const newsletterMessage = "Get new posts by email. No account or password required.";
---

<BaseLayout title="Blog" pathname="/blog/" description="Technical notes, architecture choices, and build logs.">
  <section class="mb-10 border-neutral-900">
    <p data-newsletter-message class="animate-enter max-w-lg text-sm leading-relaxed text-neutral-300" style="--delay: 40ms;">{newsletterMessage}</p>
    <form id="newsletter-unsubscribe-form" data-newsletter-form hidden action="/api/newsletter" method="post" enctype="application/x-www-form-urlencoded" class="animate-enter mt-6 max-w-lg" style="--delay: 120ms;">
        <input type="hidden" name="unsubscribe" value="" />
        <div class="flex gap-2">
          <button type="submit" class="rounded-sm border border-neutral-700 px-3 py-2 text-xs text-neutral-100 hover:border-neutral-400">
            Unsubscribe
          </button>
          <a href="/blog/" class="rounded-sm border border-neutral-800 px-3 py-2 text-xs text-neutral-400 hover:border-neutral-500 hover:text-neutral-100">
            Keep me subscribed
          </a>
        </div>
        <p data-newsletter-status class="mt-3 text-xs text-neutral-400" aria-live="polite" hidden></p>
    </form>
    <form id="newsletter-subscribe-form" data-newsletter-form action="/api/newsletter" method="post" enctype="application/x-www-form-urlencoded" class="animate-enter mt-6 max-w-lg" style="--delay: 120ms;">
        <div class="flex gap-2">
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="min-w-0 flex-1 rounded-sm border border-neutral-800 bg-transparent px-3 py-2 text-sm text-neutral-100 outline-none placeholder:text-neutral-600 focus:border-neutral-500"
          />
          <button type="submit" class="rounded-sm border border-neutral-700 px-3 py-2 text-xs text-neutral-100 hover:border-neutral-400">
            Subscribe
          </button>
        </div>
        <p data-newsletter-status class="mt-3 text-xs text-neutral-400" aria-live="polite" hidden></p>
    </form>
  </section>

  <section class="space-y-5">
    {pagination.items.map((post, index) => (
      <article class="row-border animate-enter pb-5" style={`--delay: ${220 + index * 65}ms;`}>
        <a href={`/blog/${post.id}/`} class="block">
          <h2 class="text-sm text-neutral-100">{post.data.title}</h2>
          <p class="mt-1 flex gap-2 text-xs text-neutral-400">
            <span>{formatDate(post.data.publishedAt)}</span>
            <span aria-hidden="true">·</span>
            <ViewCount client:load convexUrl={convexUrl} kind="blog" slug={post.id} />
          </p>
        </a>
      </article>
    ))}
  </section>
  <Pagination currentPage={pagination.currentPage} totalPages={pagination.totalPages} basePath="/blog" animationDelay={800} />
</BaseLayout>

<script>
  function syncNewsletterState() {
    const params = new URLSearchParams(window.location.search);
    const status = params.get("status");
    const unsubscribeToken = params.get("unsubscribe");
    const message = document.querySelector("[data-newsletter-message]");
    const subscribeForm = document.querySelector<HTMLFormElement>("#newsletter-subscribe-form");
    const unsubscribeForm = document.querySelector<HTMLFormElement>("#newsletter-unsubscribe-form");
    if (!(message instanceof HTMLElement) || !subscribeForm || !unsubscribeForm) return;

    const messages: Record<string, string> = {
      check: "Check your email and confirm the subscription.",
      "already-subscribed": "You’re already subscribed.",
      confirmed: "You’re subscribed.",
      unsubscribed: "You’re unsubscribed.",
      error: "That link is invalid or expired.",
    };
    message.textContent = unsubscribeToken
      ? "Are you sure you want to unsubscribe from new posts?"
      : messages[status ?? ""] ?? "Get new posts by email. No account or password required.";
    unsubscribeForm.hidden = !unsubscribeToken;
    subscribeForm.hidden = Boolean(unsubscribeToken) || ["confirmed", "unsubscribed", "already-subscribed"].includes(status ?? "");
    const tokenInput = unsubscribeForm.querySelector<HTMLInputElement>("input[name='unsubscribe']");
    if (tokenInput) tokenInput.value = unsubscribeToken ?? "";
  }

  function bindNewsletterForms() {
    document.querySelectorAll("[data-newsletter-form]").forEach((form) => {
      if (form.dataset.newsletterBound) return;
      form.dataset.newsletterBound = "true";
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const button = form.querySelector("button[type='submit']");
        const status = form.querySelector("[data-newsletter-status]");
        if (!(button instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return;

        button.disabled = true;
        status.hidden = false;
        status.textContent = "Sending...";
        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { Accept: "application/json", "Content-Type": "application/json" },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(typeof result.error === "string" ? result.error : "Something went wrong. Please try again.");
          status.textContent = typeof result.message === "string" ? result.message : "Done.";
          if (form.id === "newsletter-unsubscribe-form") {
            form.querySelector("div")?.remove();
          }
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : "Something went wrong. Please try again.";
          button.disabled = false;
        }
      });
    });
  }

  syncNewsletterState();
  document.addEventListener("astro:page-load", syncNewsletterState);
  bindNewsletterForms();
  document.addEventListener("astro:page-load", bindNewsletterForms);
</script>
