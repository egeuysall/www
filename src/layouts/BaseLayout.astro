---
import JsonLd from "@/components/seo/JsonLd.astro";
import DeferredPageAiOverlay from "@/components/ai/DeferredPageAiOverlay";
import { NAV_LINKS, SEO_DEFAULTS, SITE, SOCIAL_LINKS } from "@/config/site";
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  updatedTime?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  mainClass?: string;
  showPageAi?: boolean;
}

const {
  title,
  description = SITE.description,
  pathname = Astro.url.pathname,
  image = SEO_DEFAULTS.defaultOgImage,
  type = "website",
  publishedTime,
  updatedTime,
  jsonLd,
  noindex = false,
  mainClass = "",
  showPageAi = true,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(SITE.url);
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(pathname, siteOrigin).toString();
const ogImage = new URL(image, siteOrigin).toString();
const normalizePath = (value: string) => value.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);
const isPhotoGallery = currentPath === "/photo" || currentPath === "/photo/scroll";
const shouldShowAiOverlay = showPageAi;
const isNavActive = (href: string): boolean => {
  const normalizedHref = normalizePath(href);

  if (normalizedHref === "/") {
    return currentPath === "/";
  }

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---

<!doctype html>
<html lang="en" class="h-full bg-bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="theme-color" content="#050505" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <title>{pageTitle.toLowerCase()}</title>
    <link rel="canonical" href={canonical} />
    <link rel="micropub" href={new URL("/api/micropub", siteOrigin).toString()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.title} preview`} />

    <meta name="twitter:card" content={SEO_DEFAULTS.twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${SITE.title} preview`} />

    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime} />}

    {jsonLd && <JsonLd data={jsonLd} />}
    <ClientRouter />
  </head>
  <body class:list={["min-h-full bg-bg font-mono text-fg antialiased", { "photo-gallery-page": isPhotoGallery }]}>
    <div class:list={["mx-auto flex min-h-screen w-full max-w-155 flex-col px-6 py-10 sm:px-8 sm:py-12", { "photo-gallery-shell": isPhotoGallery }]}>
      <header class="site-header pb-10">
        <div class="flex items-end justify-between gap-6">
          <div>
            <a
              href="/"
              class="text-sm font-semibold tracking-normal text-neutral-100 hover:text-neutral-300 focus-visible:text-neutral-300"
            >
              {SITE.title}
            </a>
          </div>
          <nav class="flex items-center gap-4 text-xs tracking-normal text-neutral-400">
            {NAV_LINKS.map((item) => (
              <a
                href={item.href}
                class="nav-link"
                aria-current={isNavActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </header>

      <main class:list={["flex-1 pb-8", mainClass]}>
        <slot />
      </main>

      <footer class="site-footer pt-8 text-xs text-neutral-400">
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            {SOCIAL_LINKS.map((link) => {
              const isExternal = link.href.startsWith("http");

              return (
                <a
                  href={link.href}
                  target={isExternal ? "_blank" : undefined}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                  class="text-neutral-400 hover:text-neutral-100 focus-visible:text-neutral-100"
                  aria-label={link.label === "X" ? "X (Twitter)" : link.label}
                >
                  {link.label}
                </a>
              );
            })}
          </div>
          <p>&copy; {new Date().getFullYear()}</p>
        </div>
      </footer>
    </div>
    {shouldShowAiOverlay && <DeferredPageAiOverlay client:load />}
    <script>
      let lastAnalyticsPath = "";
      let analyticsIsLoading = false;
      const activateAnalytics = async () => {
        if (analyticsIsLoading) return;
        analyticsIsLoading = true;
        try {
          const { inject, pageview, computeRoute } = await import("@vercel/analytics");
          const path = window.location.pathname;
          if (lastAnalyticsPath === path) return;
          inject(
            {
              disableAutoTrack: true,
              framework: "astro",
              basePath: import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_BASEPATH,
              beforeSend: window.webAnalyticsBeforeSend,
            },
            import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_CLIENT_CONFIG,
          );
          pageview({ route: computeRoute(path, null), path });
          lastAnalyticsPath = path;
        } finally {
          analyticsIsLoading = false;
        }
      };
      const scheduleAnalytics = () => {
        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(activateAnalytics, { timeout: 4000 });
        } else {
          window.setTimeout(activateAnalytics, 2000);
        }
      };
      scheduleAnalytics();
      document.addEventListener("astro:page-load", scheduleAnalytics);
    </script>
  </body>
</html>
